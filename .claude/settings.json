{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm spec:*)",
      "Bash(node scripts/spec.mjs:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm --filter @app/web add:*)",
      "Bash(pnpm --filter @app/api add:*)",
      "Bash(pnpm --filter @app/shared add:*)",
      "Bash(pnpm --filter @app/db add:*)",
      "Bash(pnpm --filter @app/ui add:*)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm --filter @app/db migrate)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git worktree add:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.next/**)",
      "Read(./apps/*/dist/**)",
      "Read(./packages/*/dist/**)",
      "Read(**/.turbo/**)",
      "Bash(pnpm spec approve:*)",
      "Bash(pnpm spec use:*)",
      "Bash(pnpm spec pause:*)",
      "Bash(node scripts/spec.mjs approve:*)",
      "Bash(node scripts/spec.mjs use:*)",
      "Bash(node scripts/spec.mjs pause:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/spec.mjs\" context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/spec.mjs\" check-write"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/spec.mjs\" check-stop"
          }
        ]
      }
    ]
  }
}
